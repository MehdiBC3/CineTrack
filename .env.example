# Copier ce fichier en .env puis remplir les valeurs.
# Le fichier .env est ignoré par Git : aucun secret ne doit être commité.

# --- API back ---
PORT=3000

# --- Base de données PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cinetrack
DB_USER=cinetrack
DB_PASSWORD=change-moi

# --- TMDB (https://www.themoviedb.org/settings/api) ---
TMDB_API_KEY=ta-cle-tmdb
TMDB_LANGUAGE=fr-FR
